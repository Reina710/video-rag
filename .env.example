# ===== 复制本文件为 .env，填入真实密钥后启动。.env 已在 .gitignore 中，不要提交。 =====

# ---- AI 模型密钥 ----
# DashScope（阿里云）Embedding 模型 text-embedding-v3
DASHSCOPE_KEY=change-me
# DeepSeek 对话模型
DEEPSEEK_KEY=change-me

# ---- Flask 会话 ----
# 生产环境换成随机强密钥（可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=video-rag-dev-secret

# ---- Redis（登录会话）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO（对象存储，存上传视频）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos

# ---- 存储后端：sqlite（默认，本地开发）/ mysql（生产）----
STORAGE=sqlite

# ---- 密码哈希盐 ----
PASSWORD_SALT=video-rag-salt

# ---- MySQL（仅 STORAGE=mysql 时生效）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=video_rag
