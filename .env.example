# ===== 复制本文件为 .env，填入真实密钥后启动。.env 已在 .gitignore 中，不要提交。 =====

# ---- AI 模型密钥 ----
# DashScope（阿里云）Embedding 模型 text-embedding-v3
DASHSCOPE_KEY=change-me
# DeepSeek 对话模型
DEEPSEEK_KEY=change-me

# ---- Flask 会话 ----
# 生产环境换成随机强密钥（可用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=video-rag-dev-secret

# ---- Redis（登录会话）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- MinIO（对象存储，存上传视频）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=videos

# ---- 存储后端：sqlite（默认，本地开发）/ mysql（生产）----
STORAGE=sqlite

# ---- Qdrant（向量库）----
# 本地跑默认 127.0.0.1；docker compose 会把 QDRANT_HOST 覆盖成服务名 qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ---- 服务监听 ----
# 本地默认只监听 127.0.0.1；容器里由 compose 设成 0.0.0.0
HOST=127.0.0.1
PORT=8001

# ---- ASR ----
# 热词表在 data/hotwords.txt（一行一个词），这里可临时覆盖：
# ASR_HOTWORDS=碧蓝之海 无职转生
# 设 0 关闭 data/asr_fixups.txt 的错字纠正（排查是模型错还是纠错表改错）：
# ASR_FIXUPS=0
# 本地 whisper 模型目录（不填则用项目内默认路径，再退回让库自己下）
# WHISPER_MODEL_PATH=

# ---- 接口鉴权 ----
# 所有数据接口都要求登录，且只能访问自己的视频；填一个 videoId 可以把它设为公开可看（访客演示用）
# PUBLIC_MEDIA_ID=5

# ---- 密码哈希盐 ----
PASSWORD_SALT=video-rag-salt

# ---- MySQL（仅 STORAGE=mysql 时生效）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=video_rag
